# ==========================================
# Restaurant Supply Management - Backend Environment Variables
# ==========================================

# Oracle Database Connection
ORACLE_USER=system
ORACLE_PASSWORD=your_oracle_password_here
ORACLE_CONNECT_STRING=localhost:1521/xe

# Server Configuration
PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT Authentication
JWT_SECRET=your-very-long-random-secret-key-here
JWT_EXPIRES_IN=8h

# Optional Initial Admin Setup (used by migration script if provisioning default admin)
ADMIN_EMAIL=admin@supplyflow.com
ADMIN_PASSWORD=your_initial_admin_password_here
